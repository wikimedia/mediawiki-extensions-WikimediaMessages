	"wm-license-cc-by-sa-3.0-text": "ཡིག་ཆ་འདི་ནི་ [[{{int:wm-license-cc-wiki-link}}|Creative Commons]] ཀྱི་ [[creativecommons:by-sa/3.0/deed.en|ངོས་འཛིན་གུས་བཀུར་དང་མཉམ་སྤྱོད་གཅིག་མཚུངས་ ༣་༠ མ་བཅོས་པའི་]] ཆོག་མཆན་འོག་ཏུ་ཡོད།",
	"wm-license-cc-free": "ཉིད་ཀྱིས་རང་མོས་བཞིན་བསྒྲུབ་ཆོག:",
	"wm-license-cc-free-to-share-header": "མཉམ་སྤྱོད།",
	"wm-license-cc-free-to-share-text": "བརྩམས་ཆོས་འདི་འདྲ་བཤུས་བྱེད་པ་དང་། འགྲེམས་སྤེལ། རྒྱུད་སྤེལ་བཅས་བྱེད་ཆོག",
	"wm-license-cc-free-to-remix-header": "བསྐྱར་དུ་འདྲེས་གཞི་བྱས་པ།",
	"wm-license-cc-free-to-remix-text": "བརྩམས་ཆོས་འདི་སྐབས་བསྟུན་བསྒྱུར་བཅོས་བྱེད་ཆོག",
	"wm-license-cc-conditions": "གཤམ་གསལ་གྱི་ཆ་རྐྱེན་རྣམས་གཞི་རྩར་འཛིན་དགོས།",
	"wm-license-cc-conditions-attribution-header": "འབྲེལ་ཡོད་ཁུངས་བཙུན་",
	"wm-license-cc-conditions-attribution-text": "ཁྱེད་ཀྱིས་ངེས་པར་དུ་རྩོམ་པ་པོར་ངོས་འཛིན་དང་གུས་བཀུར་འོས་འཚམས་ཤིག་ཞུ་དགོས་པ་དང་། ཆོག་མཆན་གྱི་དྲ་ཐག་སྦྲེལ་དགོས། དེ་བཞིན་བཟོ་བཅོས་བརྒྱབ་ཡོད་མེད་ཀྱང་གསལ་པོར་མཚོན་དགོས། ཁྱེད་ཀྱིས་འོས་འཚམས་ཀྱི་ཐབས་ལམ་གང་རུང་བརྒྱུད་དེ་ལྟར་བྱེད་ཆོག་མོད། འོན་ཀྱང་ཆོག་མཆན་སྤྲོད་མཁན་གྱིས་ཁྱེད་དམ་ཁྱེད་ཀྱི་བཀོལ་སྤྱོད་ལ་རྒྱབ་སྐྱོར་བྱེད་ཀྱི་ཡོད་པའི་རྣམ་པ་གང་ཡང་མཚོན་མི་ཆོག",
	"wm-license-cc-conditions-share_alike-header": "གཅིག་མཚུངས་ལྟར་བརྒྱུད་སྤེལ་གྱིས།",
	"wm-license-cc-conditions-share_alike-text": "གལ་སྲིད་ཁྱེད་ཀྱིས་བརྩམས་ཆོས་འདི་སླར་བསྒྲིགས་དང་། བཟོ་བཅོས། ཡང་ན་འདི་ཉིད་གཞིར་བཟུང་ནས་བརྩམས་ཆོས་གསར་པ་བཟོ་སྐྲུན་བྱེད་ཚེ། ཁྱེད་ཀྱི་ལེགས་སྐྱེས་སམ་བརྩམས་ཆོས་དེ་དག་ངེས་པར་དུ་མ་ཕྱི་དང་གཅིག་མཚུངས་སམ་ཡང་ན་མཐུན་ཆོས་ཡོད་པའི་ཆོག་མཆན་ [[ccorg:share-your-work/licensing-considerations/compatible-licenses|same or compatible license]] འོག་འགྲེམས་སྤེལ་བྱེད་དགོས།"
}
